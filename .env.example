# Application
APP_ENV=development

# Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000
MCP_PORT=8001

# LLM provider
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://www.your.base.url/v1
LLM_API_KEY=your-secret
LLM_MODEL=your-model
LLM_API_MODE=chat_completions

# MCP
MCP_TRANSPORT=streamable-http

# Demo
DEMO_MODE=true
